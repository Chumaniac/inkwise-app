# Optional manual configuration. Prefer: uv run inkwise setup-local
# Copy to .env (chmod 600). Never commit real settings or access files.
INKWISE_DATABASE_URL=sqlite:///data/private/inkwise.sqlite3
INKWISE_DATA_DIR=data/private
INKWISE_RUBRIC_DIR=knowledge/releases
INKWISE_SERVED_FRONTEND_DIR=web
INKWISE_MAX_PENDING_PER_TENANT=20
INKWISE_MAX_UPLOAD_BYTES=10485760
INKWISE_MAX_IMAGE_PIXELS=20000000
# Local Ollama model. Create this model using deploy/Modelfile.deepseek-local.
INKWISE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
INKWISE_MODEL_NAME=inkwise-deepseek-local
INKWISE_MODEL_API_KEY=
INKWISE_MODEL_STRUCTURED_OUTPUT=json_schema
INKWISE_MODEL_TIMEOUT_SECONDS=120
INKWISE_MODEL_MAX_OUTPUT_TOKENS=4096
INKWISE_MODEL_CONCURRENCY=1
INKWISE_MODEL_CALLS_PER_JOB=12
INKWISE_JOB_TIMEOUT_SECONDS=600
# macOS: compile native/vision-ocr.swift, then set backend=vision.
# Linux: use an explicitly configured HTTP OCR adapter; disabled allows text input.
INKWISE_OCR_BACKEND=disabled
INKWISE_VISION_EXECUTABLE=artifacts/inkwise-vision
INKWISE_OCR_BASE_URL=
INKWISE_OCR_TIMEOUT_SECONDS=60
INKWISE_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
INKWISE_EMBEDDING_MODEL=bge-m3
# Set only after an independently reviewed tenant lexicon was published.
INKWISE_LEXICON_MODEL_REVISION=
# Optional graph/vector service endpoints. Empty means verified local rule fallback.
INKWISE_NEO4J_URI=
INKWISE_NEO4J_USER=
INKWISE_NEO4J_PASSWORD=
INKWISE_CHROMA_HOST=
INKWISE_CHROMA_PORT=8000
INKWISE_CHROMA_SSL=false
# Long documents need broker + chunk-worker + sufficient per-job call budget.
INKWISE_KAFKA_ENABLED=false
INKWISE_KAFKA_BOOTSTRAP_SERVERS=
INKWISE_KAFKA_TOPIC=inkwise.chunks.v1
# 0.4 routing: local by default. Cloud also requires explicit per-job consent and budget.
INKWISE_MODEL_LOCATION=auto
INKWISE_MODEL_REVISION=
INKWISE_MODEL_CONTEXT_TOKENS=65536
INKWISE_MODEL_GLOBAL_CONCURRENCY=1
# Optional exact pinned tokenizer; otherwise conservative UTF-8 byte bound.
# INKWISE_MODEL_TOKENIZER_PATH=artifacts/models/tokenizer.json
INKWISE_MODEL_TOKENIZER_SHA256=
INKWISE_CLOUD_ENABLED=false
INKWISE_CLOUD_MODEL_BASE_URL=
INKWISE_CLOUD_MODEL_NAME=
INKWISE_CLOUD_MODEL_REVISION=
INKWISE_CLOUD_MODEL_API_KEY=
INKWISE_CLOUD_CONTEXT_TOKENS=131072
INKWISE_CLOUD_STRUCTURED_OUTPUT=json_object
# Prices are MICRO-USD per MILLION tokens (1 USD = 1000000 micro-USD).
# Leave prices absent until verified against the selected provider; blank values are invalid integers.
# If the primary MODEL_BASE_URL itself is cloud, set its MODEL_INPUT/OUTPUT_PRICE_MICROUSD_PER_MILLION too.
# INKWISE_MODEL_INPUT_PRICE_MICROUSD_PER_MILLION=...
# INKWISE_MODEL_OUTPUT_PRICE_MICROUSD_PER_MILLION=...
# INKWISE_CLOUD_INPUT_PRICE_MICROUSD_PER_MILLION=...
# INKWISE_CLOUD_OUTPUT_PRICE_MICROUSD_PER_MILLION=...
INKWISE_MAX_CLOUD_COST_MICROUSD=0
# Local OCR only. Optional TrOCR package and pinned model are prepared separately.
INKWISE_OCR_SECONDARY_BACKEND=disabled
INKWISE_OCR_MODEL_PATH=artifacts/models/trocr/eaacaf452b06415df8f10bb6fad3a4c11e609406
INKWISE_OCR_DESKEW=false
INKWISE_OCR_MAX_PAGES=6
INKWISE_OCR_MAX_LINES=60
INKWISE_OCR_SECONDARY_MAX_LINES=8
INKWISE_OCR_DOCUMENT_MAX_BYTES=31457280
INKWISE_REFERENCE_PACK=teaching/reference-pack.json
INKWISE_EMBEDDING_REVISION=
INKWISE_PIPELINE_REVISION=inkwise-0.4-v1
INKWISE_CALIBRATION_DIR=data/private/calibration
# Generate a private random value once; setup-local prepares it automatically.
INKWISE_EVALUATION_SALT=
INKWISE_EVOLUTION_ENABLED=false
INKWISE_EVOLUTION_TENANT=
INKWISE_EVOLUTION_INTERVAL_SECONDS=86400
